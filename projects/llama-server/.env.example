# Copy to .env (host-local, gitignored) next to compose.yaml.
#
# Bearer key for the MCP gateway (supergateway --apiKey, fail-closed:
# with an empty or missing key the comfyui-mcp container refuses to start).
# Generate:  openssl rand -hex 32
#
# Key rotation: supergateway accepts multiple keys at once — add the new
# key, migrate clients, then remove the old one.
COMFYUI_MCP_KEY=""
